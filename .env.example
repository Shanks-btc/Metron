# Copy to .env and fill in real values. Never commit the real .env (already
# gitignored) - this file exists only to document what src/server.ts and
# buyer-agent/index.ts actually read, so a fresh clone isn't guessing.

# --- Required - the server exits immediately if either is missing ---
SELLER_ADDRESS=0xYourSellerWalletAddress
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Required for the AI-agent negotiation path (POST /ask, /agent-quote) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Required for real payment settlement (GET /pay/:id) - Coinbase
# Developer Platform credentials for the x402 facilitator's verify/settle
# endpoints. The unauthenticated discovery-only "list" endpoint works
# without these, but no real payment can settle. ---
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- Optional - Express port, defaults to 3000 ---
PORT=3000

# --- Optional - MCP seller URLs, each already defaults to the real live
# hosted instance if unset. Only needed to point at a different deployment. ---
BTC_CYCLE_MCP_URL=
SHORT_SQUEEZE_MCP_URL=
ANALYST_MOMENTUM_MCP_URL=

# --- Optional - x402 settlement network override. Both default to real Base
# mainnet (eip155:8453, real USDC) - no env vars needed for production. Set
# both together to point at Base Sepolia for pre-mainnet testing:
#   X402_NETWORK=eip155:84532
#   X402_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
#   X402_USDC_EIP712_NAME=USDC
#   X402_USDC_EIP712_VERSION=2
# (X402_USDC_EIP712_NAME/VERSION default to real mainnet USDC's actual
# on-chain EIP-712 domain, "USD Coin"/"2" - verified directly against the
# contract, not guessed. Sepolia's test USDC uses different values, "USDC"/
# "2", which is why these are separate overrides, not derived automatically.) ---
X402_NETWORK=
X402_USDC_ADDRESS=
X402_USDC_EIP712_NAME=
X402_USDC_EIP712_VERSION=

# --- Optional - only used by buyer-agent/index.ts (the CLI demo), not the
# server itself. A private key for a wallet holding real USDC on whichever
# network the server is configured for. Omit to run buyer-agent with
# --dry-run (negotiation only, no payment attempted). ---
BUYER_PRIVATE_KEY=
NEGOTIATOR_URL=http://localhost:3000
