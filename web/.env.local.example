# Copy to .env.local if you need to override any of these - the frontend
# boots and runs correctly with none of them set (all default to real Base
# mainnet, pointed at a backend on localhost:3000).

# Backend API origin. Server-side data fetches (activity/pricing/revenue)
# read QUOTE_API_URL; the client-side negotiation widget reads the
# NEXT_PUBLIC_ variant separately since it runs in the browser. Keep both in
# sync if you set either.
QUOTE_API_URL=http://localhost:3000
NEXT_PUBLIC_QUOTE_API_URL=http://localhost:3000/quote

# x402 settlement network override for the browser wallet payment flow
# (web/src/lib/payX402.ts). Both default to real Base mainnet - no env vars
# needed for production. Set both together, matching the backend's own
# X402_NETWORK/X402_USDC_ADDRESS, to test against Base Sepolia:
#   NEXT_PUBLIC_X402_NETWORK=eip155:84532
#   NEXT_PUBLIC_X402_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_X402_NETWORK=
NEXT_PUBLIC_X402_USDC_ADDRESS=
